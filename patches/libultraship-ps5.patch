 void GfxRenderingAPIOGL::SetUniforms(ShaderProgram* prg) const {
+#ifdef __PROSPERO__
+    if (!prg->frameUniformsValid || prg->lastFrameCount != mFrameCount) {
+        glUniform1i(prg->frameCountLocation, mFrameCount);
+        prg->lastFrameCount = mFrameCount;
+    }
+    if (!prg->frameUniformsValid || prg->lastNoiseScale != mCurrentNoiseScale) {
+        glUniform1f(prg->noiseScaleLocation, mCurrentNoiseScale);
+        prg->lastNoiseScale = mCurrentNoiseScale;
+    }
+    prg->frameUniformsValid = true;
+#else
     glUniform1i(prg->frameCountLocation, mFrameCount);
     glUniform1f(prg->noiseScaleLocation, mCurrentNoiseScale);
+#endif
+}
+
+#ifdef __PROSPERO__
+static void SetTextureUniform(GLint location, const GLint values[2], GLint cached[2]) {
+    // Uniforms belong to programs, so switching away and back retains the cache.
+    if (cached[0] != values[0] || cached[1] != values[1]) {
+        glUniform1iv(location, 2, values);
+        cached[0] = values[0];
+        cached[1] = values[1];
+    }
 }
+#endif
 
