new file mode 100644
index 0000000..4c05aa9
--- /dev/null
+++ b/cmake/dependencies/ps5.cmake
@@ -0,0 +1,24 @@
+#=================== ImGui ===================
+# PS5: SDL2 video driver over the static ps5-opengl SDK (Core profile).
+find_package(SDL2 REQUIRED)
+target_link_libraries(ImGui PUBLIC SDL2::SDL2-static)
+target_include_directories(ImGui PUBLIC ${PS5_OPENGL_PREFIX}/include)
+
+# PS5: the ImGui OpenGL3 backend must call the console GL entry points directly.
+# Its bundled imgl3w loader dlopens libGL.so, which does not exist on the console.
+if(TARGET ImGui)
+    target_compile_definitions(ImGui PRIVATE IMGUI_IMPL_OPENGL_LOADER_CUSTOM)
+    get_target_property(_ps5_imgui_srcs ImGui SOURCES)
+    foreach(_ps5_s IN LISTS _ps5_imgui_srcs)
+        if(_ps5_s MATCHES "imgui_impl_opengl3\\.cpp$")
+            set_source_files_properties("${_ps5_s}" PROPERTIES COMPILE_OPTIONS "-include;GL/gl.h")
+        endif()
+    endforeach()
+endif()
+
+#=================== StormLib ===================
+# FreeBSD-style libc: off_t is already 64-bit (StormLib only maps these on macOS).
+if(TARGET storm)
+    target_compile_definitions(storm PRIVATE
+        stat64=stat fstat64=fstat lseek64=lseek ftruncate64=ftruncate off64_t=off_t O_LARGEFILE=0)
+endif()
