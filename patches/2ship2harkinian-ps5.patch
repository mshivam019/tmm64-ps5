diff --git a/mm/2s2h/Enhancements/Camera/PS5CameraProfile.h b/mm/2s2h/Enhancements/Camera/PS5CameraProfile.h
new file mode 100644
--- /dev/null
+++ b/mm/2s2h/Enhancements/Camera/PS5CameraProfile.h
@@ -0,0 +1,140 @@
+#pragma once
+#include <stdexcept>
+#include <spdlog/spdlog.h>
+#include <libultraship/controller/controldeck/ControlDeck.h>
+#include <ship/Context.h>
+#include <ship/config/ConsoleVariable.h>
+#include <ship/config/Config.h>
+#include <ship/controller/controldevice/controller/Controller.h>
+#include <ship/controller/controldevice/controller/mapping/sdl/SDLButtonToButtonMapping.h>
+#include "2s2h/ShipInit.hpp"
+
+// Preserve port 0 only; other players' mappings can change while camera mode is on.
+inline nlohmann::json SnapshotPS5CameraBindings(const nlohmann::json& controllers) {
+    nlohmann::json snapshot = nlohmann::json::object();
+    for (const auto& [group, value] : controllers.items()) {
+        if (group == "Port1") snapshot[group] = value;
+        else if (value.is_object()) {
+            for (const auto& [id, mapping] : value.items()) {
+                if (id.rfind("P0", 0) == 0) snapshot[group][id] = mapping;
+            }
+        }
+    }
+    return snapshot;
+}
+
+inline nlohmann::json RestorePS5CameraBindings(nlohmann::json controllers, const nlohmann::json& snapshot) {
+    if (!snapshot.is_object() || !snapshot.contains("Port1") || !snapshot["Port1"].is_object()) {
+        throw std::runtime_error("Camera binding backup is missing Port1");
+    }
+    for (auto& [group, value] : controllers.items()) {
+        if (group != "Port1" && value.is_object()) {
+            for (auto it = value.begin(); it != value.end();) {
+                if (it.key().rfind("P0", 0) == 0) it = value.erase(it);
+                else ++it;
+            }
+        }
+    }
+    controllers["Port1"] = snapshot["Port1"];
+    for (const auto& [group, value] : snapshot.items()) {
+        if (group != "Port1") {
+            for (const auto& [id, mapping] : value.items()) controllers[group][id] = mapping;
+        }
+    }
+    return controllers;
+}
+
+inline void ApplyPS5CameraProfile() {
+    auto context = Ship::Context::GetRawInstance();
+    auto vars = context->GetConsoleVariables();
+    const bool wanted = vars->GetInteger("gSettings.PS5CameraControls", 1) != 0;
+    const bool applied = vars->GetInteger("gSettings.PS5CameraControlsApplied",
+        vars->GetInteger("gSettings.PS5CameraProfileVersion", 0) >= 1 ? 1 : 0) != 0;
+    if (wanted == applied) return;
+    auto controller = context->GetControlDeck()->GetControllerByPort(0);
+    if (controller->HasConfig()) controller->ReloadAllMappingsFromConfig();
+    else {
+        controller->AddDefaultMappings(Ship::PhysicalDeviceType::Keyboard);
+        controller->AddDefaultMappings(Ship::PhysicalDeviceType::Mouse);
+        controller->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+    }
+    auto config = context->GetConfig();
+    vars->Save();
+    if (wanted) {
+        const auto controllers = config->GetNestedJson()["CVars"]["gSettings"]["Controllers"];
+        const std::string backup = SnapshotPS5CameraBindings(controllers).dump();
+        vars->SetString("gSettings.PS5CameraBindingsBackup", backup.c_str());
+        const struct {
+            CONTROLLERBUTTONS_T cButton;
+            CONTROLLERBUTTONS_T dButton;
+            SDL_GameControllerButton physical;
+        } directions[] = {
+            {BTN_CUP, BTN_DUP, SDL_CONTROLLER_BUTTON_DPAD_UP},
+            {BTN_CDOWN, BTN_DDOWN, SDL_CONTROLLER_BUTTON_DPAD_DOWN},
+            {BTN_CLEFT, BTN_DLEFT, SDL_CONTROLLER_BUTTON_DPAD_LEFT},
+            {BTN_CRIGHT, BTN_DRIGHT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT},
+        };
+        for (const auto& direction : directions) {
+            auto button = controller->GetButton(direction.cButton);
+            for (const auto& [id, mapping] : button->GetAllButtonMappings()) {
+                // IDs are emitted by SDLAxisDirectionToButtonMapping. Preserve
+                // keyboard, mouse, face-button and trigger alternatives.
+                if (id.find("-SDLA2-AD") != std::string::npos ||
+                    id.find("-SDLA3-AD") != std::string::npos) {
+                    button->ClearButtonMapping(mapping);
+                }
+            }
+            auto mapping = std::make_shared<Ship::SDLButtonToButtonMapping>(0, direction.cButton, direction.physical);
+            button->AddButtonMapping(mapping);
+            mapping->SaveToConfig();
+            button->SaveButtonMappingIdsToConfig();
+    
+            auto dpad = controller->GetButton(direction.dButton);
+            const auto oldId = std::make_shared<Ship::SDLButtonToButtonMapping>(0, direction.dButton,
+                                                                            direction.physical)->GetButtonMappingId();
+            if (dpad->GetButtonMappingById(oldId)) dpad->ClearButtonMapping(oldId);
+        }
+        auto camera = controller->GetRightStick();
+        camera->ClearAllMappingsForDeviceType(Ship::PhysicalDeviceType::SDLGamepad);
+        camera->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+    } else {
+        const std::string backup = vars->GetString("gSettings.PS5CameraBindingsBackup", "");
+        if (!backup.empty()) {
+            try {
+                const auto controllers = config->GetNestedJson()["CVars"]["gSettings"]["Controllers"];
+                config->SetBlock("CVars.gSettings.Controllers",
+                    RestorePS5CameraBindings(controllers, nlohmann::json::parse(backup)));
+                vars->Load();
+                controller->ReloadAllMappingsFromConfig();
+            } catch (const std::exception& error) {
+                SPDLOG_ERROR("Cannot restore camera bindings: {}", error.what());
+                vars->SetInteger("gSettings.PS5CameraControls", 1);
+                vars->Save();
+                return;
+            }
+        } else {
+            // Upgrade an older camera build that had no reversible binding snapshot.
+            const struct { CONTROLLERBUTTONS_T c, d; SDL_GameControllerButton physical; } directions[] = {
+                {BTN_CUP, BTN_DUP, SDL_CONTROLLER_BUTTON_DPAD_UP},
+                {BTN_CDOWN, BTN_DDOWN, SDL_CONTROLLER_BUTTON_DPAD_DOWN},
+                {BTN_CLEFT, BTN_DLEFT, SDL_CONTROLLER_BUTTON_DPAD_LEFT},
+                {BTN_CRIGHT, BTN_DRIGHT, SDL_CONTROLLER_BUTTON_DPAD_RIGHT},
+            };
+            for (const auto& direction : directions) {
+                auto cButton = controller->GetButton(direction.c);
+                auto id = std::make_shared<Ship::SDLButtonToButtonMapping>(0, direction.c,
+                    direction.physical)->GetButtonMappingId();
+                if (cButton->GetButtonMappingById(id)) cButton->ClearButtonMapping(id);
+                cButton->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+                controller->GetButton(direction.d)->AddDefaultMappings(Ship::PhysicalDeviceType::SDLGamepad);
+            }
+            controller->GetRightStick()->ClearAllMappingsForDeviceType(Ship::PhysicalDeviceType::SDLGamepad);
+        }
+    }
+    vars->SetInteger("gSettings.PS5CameraControls", wanted);
+    vars->SetInteger("gSettings.PS5CameraControlsApplied", wanted);
+    vars->SetInteger("gSettings.PS5CameraProfileVersion", wanted ? 1 : 0);
+    vars->SetInteger("gEnhancements.Camera.FreeLook.Enable", wanted);
+    ShipInit::Init("gEnhancements.Camera.FreeLook.Enable");
+    vars->Save();
+}
